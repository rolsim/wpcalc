{
  "version": "2.0.0",
  "tasks": [
    {
      // Prepares .dev/wpcalc.db so F5 has something to serve.
      //
      // `serve` refuses to start with an empty user table, so a bare F5 would
      // otherwise exit immediately with "no accounts exist". This creates the
      // account and seeds a demo month on first run only — the guard is the
      // database file, so re-running F5 never duplicates the seed data or
      // fails on an account that already exists.
      "label": "wpcalc: prepare dev database",
      "type": "shell",
      "command": "./scripts/dev-setup.sh 8080 .dev/wpcalc.db",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // Deletes the dev database so the next F5 reseeds from scratch.
      "label": "wpcalc: reset dev database",
      "type": "shell",
      "command": "rm -f .dev/wpcalc.db .dev/wpcalc.db-shm .dev/wpcalc.db-wal && echo 'dev database removed; next F5 will reseed'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "wpcalc: check",
      "type": "shell",
      "command": "make check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$go"]
    },
    {
      "label": "wpcalc: e2e (browser)",
      "type": "shell",
      "command": "make e2e",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$go"]
    },
    {
      "label": "wpcalc: e2e (WordPress)",
      "type": "shell",
      "command": "make e2e-wp",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$go"]
    }
  ]
}
