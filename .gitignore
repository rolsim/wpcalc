# Scratch files: anything with `.untracked.` in the name, at any depth.
*.untracked.*

# Build output, at any depth: bin/ at the root, and wordpress/wpcalc/bin/
# where the e2e test compiles the sidecar the plugin ships.
bin/

# Local databases and runtime artifacts
*.db
*.db-shm
*.db-wal
*.sock
*.pid

# Test output
/coverage.out

# VS Code dev database and socket
/.dev/
